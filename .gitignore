# Publish only reviewed source, tests, assets and documentation.
# Local installation state, diagnostic history and release outputs stay private.
*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/build.py
!/settings.example.json
!/src/
!/src/*.py
!/src/*.swift
!/tools/
!/tools/*.py
!/tests/
!/tests/*.py
!/tests/*.js
!/tests/*.c
!/interface/
!/interface/*.html
!/interface/*.css
!/interface/*.js
!/interface/*.json
!/assets/
!/assets/*.svg
!/assets/*.png
!/assets/*.icns
!/docs/
!/docs/*.md
!/references/
!/references/lulu-cli-review/
!/references/lulu-cli-review/main.swift
!/references/lulu-cli-review/LICENSE
!/references/lulu-cli-review/NOTICE.md
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml

__pycache__/
*.py[cod]
.DS_Store
